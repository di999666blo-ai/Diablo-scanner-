<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permission for the floating scanner bubble -->
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service permissions -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Screen capture service permission -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Notifications -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <application
    android:allowBackup="false"
    android:label="DIABLO SCANNER"
    android:icon="@drawable/ic_diablo_launcher"
    android:roundIcon="@drawable/ic_diablo_launcher"
    android:theme="@android:style/Theme.Material.NoActionBar"
    android:hardwareAccelerated="true"
    android:supportsRtl="true">

        <!-- Main app screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Floating scanner bubble -->
        <service
            android:name=".FloatingBubbleService"
            android:exported="false" />

        <!-- Live screen capture service -->
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>

</manifest>
